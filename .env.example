# Server configuration
PORT=3000
DB_PATH=./data/euler.db
LOG_LEVEL=info

# Data sources (set to false to disable)
BINANCE_ENABLED=true
YAHOO_ENABLED=true
TRADINGVIEW_ENABLED=true
WEBULL_ENABLED=true

# Binance API credentials (optional, for higher rate limits)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Data integrity settings
MAX_DEVIATION=0.02
MIN_SOURCES=2

# Cache settings (in milliseconds)
QUOTE_TTL=5000
HISTORY_TTL=60000
